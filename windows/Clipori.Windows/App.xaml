<Application x:Class="Clipori.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#9C7DE2"/>
    <SolidColorBrush x:Key="InkBrush" Color="#302C3B"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#887F97"/>
    <Style TargetType="Button" x:Key="ActionButton">
      <Setter Property="Background" Value="#F2EDF9"/>
      <Setter Property="Foreground" Value="#7054B9"/>
      <Setter Property="Padding" Value="11,7"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Back" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Back" Property="Opacity" Value="0.76"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Back" Property="Opacity" Value="0.55"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
