<Window x:Class="Clipori.Windows.Views.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Clipori 设置" Width="650" Height="680" MinWidth="540" WindowStartupLocation="CenterOwner" Background="#FAF8FD"
 FontFamily="Segoe UI,Microsoft YaHei UI">
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock FontSize="21" FontWeight="SemiBold" Foreground="#62507C" Text="Clipori · 设置" Margin="0,0,0,15"/>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
   <StackPanel>
    <TextBlock Text="交互与隐私" FontWeight="Bold" Margin="0,5,0,10"/>
    <CheckBox x:Name="ClickPaste" Content="单击即粘贴（关闭时：单击复制并显示详情、双击粘贴，默认关闭）" Margin="0,0,0,9"/>
    <Separator Margin="0,5,0,10"/>
    <TextBlock Text="快捷键自定义" FontWeight="Bold" Margin="0,0,0,9"/>
    <TextBlock Text="全局唤醒快捷键（若被其他软件占用，保存后会提示）" FontSize="11" Margin="0,0,0,5"/>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
      <ComboBox x:Name="HotkeyModifiers" Width="170" Height="29" Margin="0,0,10,0"/>
      <ComboBox x:Name="HotkeyKey" Width="120" Height="29"/>
    </StackPanel>
    <TextBlock Text="应用内快捷键（例如 Ctrl+F、Ctrl+N，不能重复）" FontSize="11" Margin="0,0,0,5"/>
    <Grid Margin="0,0,0,11">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="115"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="115"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="115"/></Grid.ColumnDefinitions>
      <TextBlock Text="搜索" VerticalAlignment="Center" Margin="0,0,6,0"/>
      <TextBox x:Name="SearchShortcut" Grid.Column="1" Height="26" Padding="6,3"/>
      <TextBlock Text="新建便笺" Grid.Column="2" VerticalAlignment="Center" Margin="14,0,6,0"/>
      <TextBox x:Name="NewNoteShortcut" Grid.Column="3" Height="26" Padding="6,3"/>
      <TextBlock Text="暂停" Grid.Column="4" VerticalAlignment="Center" Margin="14,0,6,0"/>
      <TextBox x:Name="PauseShortcut" Grid.Column="5" Height="26" Padding="6,3"/>
    </Grid>
    <Separator Margin="0,3,0,10"/>
    <TextBlock Text="检索性能" FontWeight="Bold" Margin="0,0,0,7"/>
    <TextBlock Text="支持精准、错别字容错、中文跳字模糊匹配；默认最多展示 70 条结果。" FontSize="11" Foreground="#8D7DA5" Margin="0,0,0,12" TextWrapping="Wrap"/>
    <CheckBox x:Name="AutoHide" Content="点击面板外自动隐藏" Margin="0,0,0,9"/>
    <CheckBox x:Name="AutoLaunch" Content="随 Windows 登录启动" Margin="0,0,0,9"/>
    <TextBlock Text="历史保留天数：1 / 7 / 30 / 365 / 0（永久）" Margin="0,0,0,5"/>
    <TextBox x:Name="Retention" Width="110" HorizontalAlignment="Left" Padding="7,5" Margin="0,0,0,10"/>
    <TextBlock Text="排除应用进程名（逗号分隔，如 KeePass,Bitwarden）" Margin="0,0,0,5"/>
    <TextBox x:Name="ExcludedApps" TextWrapping="Wrap" MinHeight="42" Padding="6" Margin="0,0,0,12"/>
    <Separator/>
    <TextBlock Text="AI 兼容接口 · 可选" FontWeight="Bold" Margin="0,12,0,7"/>
    <ComboBox x:Name="AiProtocol" Width="160" HorizontalAlignment="Left" Margin="0,0,0,7">
     <ComboBoxItem Content="OpenAI"/><ComboBoxItem Content="Anthropic"/>
    </ComboBox>
    <TextBlock Text="HTTPS API Endpoint" FontSize="11"/>
    <TextBox x:Name="AiEndpoint" Padding="7,5" Margin="0,3,0,9"/>
    <TextBlock Text="模型名称" FontSize="11"/>
    <TextBox x:Name="AiModel" Padding="7,5" Margin="0,3,0,9"/>
    <TextBlock Text="API Key（加密保存在本机账户；留空则保留原值）" FontSize="11"/>
    <PasswordBox x:Name="ApiKey" Padding="7,5" Margin="0,3,0,9"/>
    <CheckBox x:Name="AutoClassify" Content="自动分类（向 AI 发送复制的文字，默认关闭）" Margin="0,0,0,10"/>
    <Separator/>
    <TextBlock Text="自定义分类" FontWeight="Bold" Margin="0,12,0,8"/>
    <DockPanel Margin="0,0,0,10">
     <Button Content="添加分类" DockPanel.Dock="Right" Click="AddCategory_Click" Padding="12,6" Margin="8,0,0,0"/>
     <TextBox x:Name="NewCategoryName" Padding="7,5" ToolTip="输入分类名称"/>
    </DockPanel>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
      <TextBlock Text="颜色 #" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <TextBox x:Name="CategoryColor" Width="100" Text="#AE90DB" Padding="7,5" Margin="0,0,14,0"/>
      <CheckBox x:Name="CreatePinboard" Content="建立 Pinboard（永久保留其中的记录）" VerticalAlignment="Center"/>
    </StackPanel>
    <ListBox x:Name="CategoryList" Height="90" Margin="0,0,0,8"/>
    <Button Content="更新选中分类颜色" HorizontalAlignment="Left" Padding="10,5" Click="UpdateCategoryColor_Click" Margin="0,0,0,9"/>
    <Button Content="删除选中分类（保留其中的历史记录）" Click="DeleteCategory_Click" HorizontalAlignment="Left" Padding="10,5" Margin="0,0,0,10"/>
    <Separator/>
    <TextBlock Text="诊断与调试" FontWeight="Bold" Margin="0,12,0,6"/>
    <CheckBox x:Name="EnableDiagnostics" Content="保留本地运行日志（不记录剪贴板正文）" Margin="0,0,0,8"/>
    <Button Content="打开日志文件夹" HorizontalAlignment="Left" Padding="12,7" Click="OpenLogs_Click" Margin="0,0,0,12"/>
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
   <Button Content="取消" Padding="16,8" Margin="0,0,10,0" Click="Cancel_Click"/>
   <Button Content="保存设置" Padding="16,8" Background="#9F83DA" Foreground="White" BorderThickness="0" Click="Save_Click"/>
  </StackPanel>
 </Grid>
</Window>
