<Window x:Class="Clipori.Windows.Views.EntryDetailWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Clipori · 详情" Width="840" Height="640" MinWidth="520" MinHeight="390"
 WindowStartupLocation="CenterOwner" Background="#F8F6FD" FontFamily="Segoe UI,Microsoft YaHei UI">
 <Window.Resources>
  <Style TargetType="Button" x:Key="DetailButton">
   <Setter Property="Padding" Value="12,7"/>
   <Setter Property="Margin" Value="0,0,7,0"/>
   <Setter Property="Background" Value="#EEE7F9"/>
   <Setter Property="Foreground" Value="#684D9A"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Cursor" Value="Hand"/>
  </Style>
 </Window.Resources>
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Grid.Row="0" Margin="0,0,0,14">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock x:Name="Heading" FontSize="19" FontWeight="SemiBold" Foreground="#392B4D" TextTrimming="CharacterEllipsis"/>
    <TextBlock x:Name="Meta" FontSize="11" Foreground="#93849C" Margin="0,5,0,0"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <Button Content="复制" Click="Copy_Click" Style="{StaticResource DetailButton}"/>
    <Button Content="粘贴到原应用" Click="Paste_Click" Style="{StaticResource DetailButton}"/>
    <Button Content="关闭" Click="Close_Click" Style="{StaticResource DetailButton}"/>
   </StackPanel>
  </Grid>
  <Border Grid.Row="1" Background="#EDE8F6" CornerRadius="8" Padding="12,7" Margin="0,0,0,10">
   <TextBlock x:Name="NotesInfo" Foreground="#726181" FontSize="11" TextWrapping="Wrap"/>
  </Border>
  <Border Grid.Row="2" Background="White" BorderBrush="#E7E0EF" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
   <Grid>
    <TextBox x:Name="TextContent" IsReadOnly="True" AcceptsReturn="True" FontFamily="Cascadia Code,Consolas,Microsoft YaHei UI"
             FontSize="13" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Padding="17"
             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
    <ScrollViewer x:Name="ImageScroller" Visibility="Collapsed"
         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#F1EEF5"
         PreviewMouseWheel="ImageScroller_PreviewMouseWheel">
      <Grid MinWidth="280" MinHeight="270">
       <Image x:Name="DetailImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
              RenderOptions.BitmapScalingMode="HighQuality">
        <Image.LayoutTransform><ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1"/></Image.LayoutTransform>
       </Image>
      </Grid>
    </ScrollViewer>
   </Grid>
  </Border>
  <Grid Grid.Row="3" Margin="0,12,0,0">
   <StackPanel x:Name="ZoomControls" Visibility="Collapsed" Orientation="Horizontal" HorizontalAlignment="Left">
    <Button Content="−" Style="{StaticResource DetailButton}" FontSize="16" Click="ZoomOut_Click"/>
    <TextBlock x:Name="ZoomLabel" Text="100%" Width="60" TextAlignment="Center" VerticalAlignment="Center"/>
    <Button Content="＋" Style="{StaticResource DetailButton}" FontSize="16" Click="ZoomIn_Click"/>
    <Button Content="100%" Style="{StaticResource DetailButton}" Click="ActualSize_Click"/>
    <Button Content="适应窗口" Style="{StaticResource DetailButton}" Click="Fit_Click"/>
   </StackPanel>
   <TextBlock Grid.Column="0" Text="图片：Ctrl+滚轮缩放 · 文字可选择和复制" Foreground="#A397B0"
      HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
  </Grid>
 </Grid>
</Window>
