<Window x:Class="Clipori.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clipori for Windows" Width="1180" Height="398"
        AllowsTransparency="True" Background="Transparent" WindowStyle="None"
        ShowInTaskbar="False" ResizeMode="NoResize" Topmost="True"
        WindowStartupLocation="Manual" FontFamily="Segoe UI,Microsoft YaHei UI"
        PreviewKeyDown="Window_PreviewKeyDown" Deactivated="Window_Deactivated">
  <Window.Resources>
    <Style x:Key="CategoryTab" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#7B7388"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
  </Window.Resources>
  <Grid Margin="7">
    <Border CornerRadius="25" BorderBrush="#D9CDEB" BorderThickness="1">
      <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="7" Opacity="0.25" Color="#3D2A55"/></Border.Effect>
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#FCFBFE" Offset="0"/>
          <GradientStop Color="#F4F0FB" Offset="0.65"/>
          <GradientStop Color="#F7F6FB" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="68"/>
          <RowDefinition Height="39"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="41"/>
        </Grid.RowDefinitions>

        <!-- Main toolbar -->
        <Grid Grid.Row="0" Margin="22,10,22,4" MouseLeftButtonDown="Header_MouseLeftButtonDown">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="335"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Width="44" Height="44" CornerRadius="13" Background="#EDE3FB" Margin="0,0,11,0">
            <TextBlock Text="✦" FontSize="25" Foreground="#9270D1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="Clipori" FontSize="19" FontWeight="Bold" Foreground="#393045"/>
            <TextBlock Text="留住每一闪灵感  ·  WINDOWS" FontSize="9" Foreground="#90849F"/>
          </StackPanel>
          <Border Grid.Column="2" Height="38" CornerRadius="12" Background="#FFFFFF" BorderBrush="#E6DDEE" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,10,0">
            <DockPanel Margin="12,0">
              <TextBlock Text="⌕" FontSize="22" Foreground="#A898BE" DockPanel.Dock="Left" Margin="0,0,7,0" VerticalAlignment="Center"/>
              <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" FontSize="12" Foreground="#544A62" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" ToolTip="搜索剪贴板历史 / Ctrl+F"/>
            </DockPanel>
          </Border>
          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="PauseButton" Content="暂停记录" Margin="0,0,7,0" Style="{StaticResource ActionButton}" Click="PauseButton_Click" ToolTip="暂停/恢复剪贴板记录 (Ctrl+T)"/>
            <Button Content="＋ 便笺" Margin="0,0,7,0" Style="{StaticResource ActionButton}" Click="NewNote_Click"/>
            <Button Content="×" FontSize="18" Padding="10,6" Style="{StaticResource ActionButton}" Click="CloseButton_Click" ToolTip="收起到托盘 (Esc)"/>
          </StackPanel>
        </Grid>

        <!-- Lightweight type filters -->
        <Grid Grid.Row="1" Margin="22,1,22,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="AllTab" Content="◈ 全部记忆" Tag="all" Click="Category_Click" Style="{StaticResource CategoryTab}"/>
            <Button x:Name="TextTab" Content="● 文字" Tag="text" Click="Category_Click" Style="{StaticResource CategoryTab}"/>
            <Button x:Name="LinkTab" Content="● 链接" Tag="link" Click="Category_Click" Style="{StaticResource CategoryTab}"/>
            <Button x:Name="CodeTab" Content="● 代码" Tag="code" Click="Category_Click" Style="{StaticResource CategoryTab}"/>
            <Button x:Name="ImageTab" Content="● 图片" Tag="image" Click="Category_Click" Style="{StaticResource CategoryTab}"/>
            <Button x:Name="PinnedTab" Content="⌖ 固定" Tag="pinned" Click="Category_Click" Style="{StaticResource CategoryTab}"/>
          </StackPanel>
          <TextBlock x:Name="CountLabel" Text="0 条记忆" FontSize="11" Foreground="#958CA2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <!-- Original Mac layout: horizontal cards with hover elevation -->
        <Grid Grid.Row="2">
          <ScrollViewer x:Name="CardsScroller" Margin="11,1,11,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
            <ItemsControl x:Name="CardsList">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border x:Name="CardBody" Width="194" Height="212" Background="#FEFDFF"
                          BorderBrush="#E4DCEB" BorderThickness="1" CornerRadius="16"
                          Padding="13,11" Margin="7,13,6,4" Cursor="Hand"
                          MouseLeftButtonUp="Card_MouseLeftButtonUp"
                          ToolTip="单击复制 · 双击粘贴 · 右键更多操作">
                    <Border.RenderTransform><TranslateTransform x:Name="Lift" Y="0"/></Border.RenderTransform>
                    <Border.Triggers>
                      <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="-8" Duration="0:0:0.18"/></Storyboard></BeginStoryboard>
                      </EventTrigger>
                      <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.18"/></Storyboard></BeginStoryboard>
                      </EventTrigger>
                    </Border.Triggers>
                    <Border.ContextMenu>
                      <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="复制" Click="CopyMenu_Click"/>
                        <MenuItem Header="粘贴到之前的应用" Click="PasteMenu_Click"/>
                        <MenuItem Header="预览" Click="PreviewMenu_Click"/>
                        <Separator/>
                        <MenuItem Header="固定 / 取消固定" Click="PinMenu_Click"/>
                        <MenuItem Header="删除记录" Click="DeleteMenu_Click"/>
                      </ContextMenu>
                    </Border.ContextMenu>
                    <Grid>
                      <Grid.RowDefinitions><RowDefinition Height="29"/><RowDefinition Height="30"/><RowDefinition Height="*"/><RowDefinition Height="22"/></Grid.RowDefinitions>
                      <DockPanel Grid.Row="0">
                        <Border Width="26" Height="26" Background="#EFE6FA" CornerRadius="8" DockPanel.Dock="Left" Margin="0,0,6,0">
                          <TextBlock Text="{Binding Glyph}" FontSize="11" Foreground="#8A68CB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding PinMark}" DockPanel.Dock="Right" FontSize="10" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Source}" FontSize="10" FontWeight="SemiBold" Foreground="#967FB3" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      </DockPanel>
                      <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="#393143" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                      <Grid Grid.Row="2" Margin="0,5,0,0" ClipToBounds="True">
                        <TextBlock x:Name="ContentPreview" Text="{Binding Preview}" TextWrapping="Wrap" FontSize="11" Foreground="#6F687B" LineHeight="17" MaxHeight="99" VerticalAlignment="Top"/>
                        <Border x:Name="ImageFrame" Visibility="Collapsed" Background="#EAE2F4" CornerRadius="9">
                          <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                        </Border>
                      </Grid>
                      <DockPanel Grid.Row="3" LastChildFill="False" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding TypeLabel}" FontSize="10" Foreground="#8A6DB5" DockPanel.Dock="Left"/>
                        <TextBlock Text="{Binding When}" FontSize="10" Foreground="#B1A6B8" DockPanel.Dock="Right"/>
                      </DockPanel>
                    </Grid>
                  </Border>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="image">
                      <Setter TargetName="ImageFrame" Property="Visibility" Value="Visible"/>
                      <Setter TargetName="ContentPreview" Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                      <Setter TargetName="CardBody" Property="BorderBrush" Value="#BEA0E7"/>
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <StackPanel x:Name="EmptyHint" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
            <TextBlock Text="✦" FontSize="53" Foreground="#B7A0DC" Margin="0,0,22,0"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="你的记忆，从一次复制开始。" FontSize="20" Foreground="#594B69" FontWeight="SemiBold"/>
              <TextBlock Text="复制文字、链接或者图片，Clipori 会默默收藏。" Margin="0,7,0,0" Foreground="#A297B0" FontSize="12"/>
            </StackPanel>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="22,0,22,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#6BCAA0" Margin="0,0,8,0"/>
            <TextBlock x:Name="StatusLabel" Text="正在悄悄记住" FontSize="11" Foreground="#90849C" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#9C94A9" FontSize="10" Text="Ctrl+Alt+V 唤醒  ·  单击复制  ·  双击粘贴  ·  Esc 收起"/>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
