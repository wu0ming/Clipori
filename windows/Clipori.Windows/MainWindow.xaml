<Window x:Class="Clipori.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Clipori.Windows.Controls"
        Title="Clipori for Windows" Width="1240" Height="438"
        AllowsTransparency="True" Background="Transparent" WindowStyle="None"
        ShowInTaskbar="False" ResizeMode="NoResize" Topmost="True"
        WindowStartupLocation="Manual" FontFamily="Segoe UI,Microsoft YaHei UI"
        PreviewKeyDown="Window_PreviewKeyDown" Deactivated="Window_Deactivated">
  <Window.Resources>
    <Style x:Key="CategoryTab" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#7B7388"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
  </Window.Resources>
  <Grid Margin="7">
    <Border CornerRadius="25" BorderBrush="#E2D7EE" BorderThickness="1">
      <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="9" Opacity="0.20" Color="#574568"/></Border.Effect>
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#F8FFFFFF" Offset="0"/>
          <GradientStop Color="#F3F5EFFB" Offset="0.65"/>
          <GradientStop Color="#F5F8F7FD" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="68"/>
          <RowDefinition Height="39"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="41"/>
        </Grid.RowDefinitions>

        <!-- Main toolbar -->
        <Grid Grid.Row="0" Margin="22,10,22,4" MouseLeftButtonDown="Header_MouseLeftButtonDown">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="335"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <!-- Custom vector mascot (no upstream logo asset copied). -->
          <Grid Width="44" Height="44" Margin="0,0,11,0">
            <Border CornerRadius="13" Background="#EDE2FB"/>
            <Ellipse Width="32" Height="32" Fill="#B39AE6"/>
            <Path Data="M 13,25 L 14,13 L 23,22 L 31,22 L 39,13 L 40,25 C 43,38 33,41 27,41 C 16,41 10,33 13,25 Z"
                  Fill="#FFFFFF" Stretch="Fill" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Ellipse Width="3.6" Height="5" Fill="#7E58BE" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-10,7,0,0"/>
            <Ellipse Width="3.6" Height="5" Fill="#7E58BE" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="9,7,0,0"/>
            <Ellipse Width="4" Height="2.8" Fill="#7E58BE" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,17,0,0"/>
          </Grid>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="Clipori" FontSize="19" FontWeight="Bold" Foreground="#393045"/>
            <TextBlock Text="留住每一闪灵感  ·  WINDOWS EDITION" FontSize="9" Foreground="#90849F"/>
          </StackPanel>
          <Border Grid.Column="2" Height="38" CornerRadius="12" Background="#FFFFFF" BorderBrush="#F3FFFFFF" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,10,0">
            <DockPanel Margin="12,0">
              <TextBlock Text="⌕" FontSize="22" Foreground="#A898BE" DockPanel.Dock="Left" Margin="0,0,7,0" VerticalAlignment="Center"/>
              <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" FontSize="12" Foreground="#544A62" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" ToolTip="搜索剪贴板历史 / Ctrl+F"/>
            </DockPanel>
          </Border>
          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="PauseButton" Content="⏸" Margin="0,0,6,0" Padding="10,7" Style="{StaticResource ActionButton}" Click="PauseButton_Click" ToolTip="暂停/恢复剪贴板记录 (Ctrl+T)"/>
            <Button Content="✨ AI 找回" Margin="0,0,7,0" Style="{StaticResource ActionButton}" Click="AiSearch_Click"/>
            <Button Content="＋" FontSize="17" Margin="0,0,6,0" Padding="10,5" ToolTip="新建便笺（Ctrl+N）" Style="{StaticResource ActionButton}" Click="NewNote_Click"/>
            <Button Content="⚙" Margin="0,0,6,0" Style="{StaticResource ActionButton}" Click="Settings_Click" ToolTip="设置、AI、诊断、分类"/>
            <Button Content="×" FontSize="18" Padding="10,6" Style="{StaticResource ActionButton}" Click="CloseButton_Click" ToolTip="收起到托盘 (Esc)"/>
          </StackPanel>
        </Grid>

        <!-- Lightweight type filters -->
        <Grid Grid.Row="1" Margin="22,1,22,0">
          <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="0,0,84,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="AllTab" Content="◈ 全部记忆" Tag="all" Click="Category_Click" Style="{StaticResource CategoryTab}"/>
            <Button x:Name="TextTab" Content="● 文字" Tag="text" Click="Category_Click" Style="{StaticResource CategoryTab}"/>
            <Button x:Name="LinkTab" Content="● 链接" Tag="link" Click="Category_Click" Style="{StaticResource CategoryTab}"/>
            <Button x:Name="CodeTab" Content="● 代码" Tag="code" Click="Category_Click" Style="{StaticResource CategoryTab}"/>
            <Button x:Name="ImageTab" Content="● 图片" Tag="image" Click="Category_Click" Style="{StaticResource CategoryTab}"/>
            <Button x:Name="FileTab" Content="● 文件" Tag="files" Click="Category_Click" Style="{StaticResource CategoryTab}"/>
            <Button x:Name="PinnedTab" Content="⌖ 固定" Tag="pinned" Click="Category_Click" Style="{StaticResource CategoryTab}"/>
            <StackPanel x:Name="CustomCategories" Orientation="Horizontal"/>
            </StackPanel>
          </ScrollViewer>
          <TextBlock x:Name="CountLabel" Text="0 条记忆" FontSize="11" Foreground="#958CA2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <!-- Original Mac layout: horizontal cards with hover elevation -->
        <Grid Grid.Row="2">
          <ScrollViewer x:Name="CardsScroller" Margin="21,0,21,0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" CanContentScroll="True" PreviewMouseWheel="CardsScroller_PreviewMouseWheel">
            <ItemsControl x:Name="CardsList" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border x:Name="CardBody" Width="237" Height="233" BorderThickness="1" CornerRadius="16"
                          Padding="16,13" Margin="8,16,7,12" Cursor="Hand"
                          MouseLeftButtonDown="Card_MouseLeftButtonDown" MouseMove="Card_MouseMove"
                          MouseLeftButtonUp="Card_MouseLeftButtonUp"
                          ToolTip="单击复制并打开详情 · 双击粘贴 · Ctrl+单击多选">
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FAFFFFFF" Offset="0"/>
                        <GradientStop Color="#EAFDF9FF" Offset="0.62"/>
                        <GradientStop Color="#F0F1EAF9" Offset="1"/>
                      </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                      <DropShadowEffect Color="#5B4A79" BlurRadius="10" ShadowDepth="3" Opacity="0.09"/>
                    </Border.Effect>
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="#EBFFFFFF"/>
                        <Style.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="#C2AFE4"/>
                          </Trigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <Border.RenderTransform><TranslateTransform x:Name="Lift" Y="0"/></Border.RenderTransform>
                    <Border.Triggers>
                      <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="-6" Duration="0:0:0.22"/></Storyboard></BeginStoryboard>
                      </EventTrigger>
                      <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.24"/></Storyboard></BeginStoryboard>
                      </EventTrigger>
                    </Border.Triggers>
                    <Border.ContextMenu>
                      <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                   Opened="ContextMenu_Opened" Closed="ContextMenu_Closed">
                        <MenuItem Header="复制" Click="CopyMenu_Click"/>
                        <MenuItem Header="粘贴到之前的应用" Click="PasteMenu_Click"/>
                        <MenuItem Header="预览" Click="PreviewMenu_Click"/>
                        <MenuItem Header="编辑 / 备注" Click="EditMenu_Click"/>
                        <MenuItem Header="移动到分类" SubmenuOpened="CategoryMenu_Opened"/>
                        <Separator/>
                        <MenuItem Header="固定 / 取消固定" Click="PinMenu_Click"/>
                        <MenuItem Header="删除记录" Click="DeleteMenu_Click"/>
                      </ContextMenu>
                    </Border.ContextMenu>
                    <Grid>
                      <Grid.RowDefinitions><RowDefinition Height="29"/><RowDefinition Height="45"/><RowDefinition Height="*"/><RowDefinition Height="22"/></Grid.RowDefinitions>
                      <DockPanel Grid.Row="0">
                        <Border Width="26" Height="26" Background="#EFE6FA" CornerRadius="8" DockPanel.Dock="Left" Margin="0,0,6,0">
                          <TextBlock Text="{Binding Glyph}" FontSize="11" Foreground="#8A68CB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding IndexLabel}" DockPanel.Dock="Right" FontSize="10" Foreground="#AD9BBE" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PinMark}" DockPanel.Dock="Right" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding Source}" FontSize="10" FontWeight="SemiBold" Foreground="#967FB3" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      </DockPanel>
                      <TextBlock Grid.Row="1" controls:SearchHighlight.Text="{Binding Title}" controls:SearchHighlight.Query="{Binding SearchQuery, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" FontSize="15" FontWeight="SemiBold" Foreground="#393143" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="42" VerticalAlignment="Center"/>
                      <Grid Grid.Row="2" Margin="0,5,0,0" ClipToBounds="True">
                        <TextBlock x:Name="ContentPreview" controls:SearchHighlight.Text="{Binding SearchSnippet}" controls:SearchHighlight.Query="{Binding SearchQuery, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" TextWrapping="Wrap" FontSize="12" Foreground="#796F83" LineHeight="19" MaxHeight="96" VerticalAlignment="Top"/>
                        <Border x:Name="ImageFrame" Visibility="Collapsed" Background="#EAE2F4" CornerRadius="9">
                          <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                        </Border>
                      </Grid>
                      <DockPanel Grid.Row="3" LastChildFill="False" VerticalAlignment="Bottom">
                        <Border DockPanel.Dock="Left" Background="#F0E5FB" CornerRadius="8" Padding="8,3">
                          <TextBlock Text="{Binding CategoryLabel}" FontSize="10" Foreground="#8464BB" FontWeight="Medium"/>
                        </Border>
                        <TextBlock Text="{Binding When}" FontSize="10" Foreground="#B1A6B8" DockPanel.Dock="Right"/>
                      </DockPanel>
                    </Grid>
                  </Border>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="image">
                      <Setter TargetName="ImageFrame" Property="Visibility" Value="Visible"/>
                      <Setter TargetName="ContentPreview" Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                      <Setter TargetName="CardBody" Property="BorderBrush" Value="#8360C5"/>
                      <Setter TargetName="CardBody" Property="BorderThickness" Value="2"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                      <Setter TargetName="CardBody" Property="BorderBrush" Value="#BEA0E7"/>
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Button Content="‹" Width="26" Height="47" HorizontalAlignment="Left" VerticalAlignment="Center"
                  Background="#D4C8E4" Foreground="#6E588D" BorderThickness="0" Opacity="0.55" 
                  FontSize="23" ToolTip="上一组记录" Click="ScrollLeft_Click"/>
          <Button Content="›" Width="26" Height="47" HorizontalAlignment="Right" VerticalAlignment="Center"
                  Background="#D4C8E4" Foreground="#6E588D" BorderThickness="0" Opacity="0.55"
                  FontSize="23" ToolTip="下一组记录" Click="ScrollRight_Click"/>
          <StackPanel x:Name="EmptyHint" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
            <TextBlock Text="✦" FontSize="53" Foreground="#B7A0DC" Margin="0,0,22,0"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="你的记忆，从一次复制开始。" FontSize="20" Foreground="#594B69" FontWeight="SemiBold"/>
              <TextBlock Text="复制文字、链接或者图片，Clipori 会默默收藏。" Margin="0,7,0,0" Foreground="#A297B0" FontSize="12"/>
            </StackPanel>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="22,0,22,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#6BCAA0" Margin="0,0,8,0"/>
            <TextBlock x:Name="StatusLabel" Text="正在悄悄记住" FontSize="11" Foreground="#90849C" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#9C94A9" FontSize="10" Text="Ctrl+Alt+V 唤醒（可自定义）  ·  单击详情 / 双击粘贴  ·  Esc 收起"/>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
